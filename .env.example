# Where the server reaches the bridge. The browser never uses this — it always
# calls this app's own /api/bff proxy, whose path is hardcoded.
# Server-side calls use API_BASE_URL if set, otherwise NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# true only when a reverse proxy you control overwrites X-Forwarded-For.
# See .env.production for why this must stay false on a directly exposed Node.
TRUST_PROXY_HEADERS=false

# How WHMCS amounts map to the displayed unit.
#   toman        = stored in Rial, shown in Toman (divided by 10)  [default]
#   rial         = stored in Rial, shown in Rial
#   toman_direct = already stored in Toman, shown as-is
# Verify against one product price in WHMCS admin before going live.
NEXT_PUBLIC_CURRENCY_DISPLAY=toman

NEXT_PUBLIC_BRAND_NAME=LithiumHost
